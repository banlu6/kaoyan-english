/* components/exam-reader/exam-reader.wxss
   横屏阅读器：整体 flex 纵向 顶栏 / 主体 / 底栏；主体 flex 横向 左文章 右题卡。
   单位说明：横屏下 rpx 会以长边为基准导致尺寸失真，故本组件全部使用 px / vh / vw / em。 */

.reader {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #F4F5F6;
  color: #1F2328;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* ------------------------------- 顶栏 ------------------------------- */
.bar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 46px;
  padding: 0 10px;
  background: #1F5C4A;
  color: #fff;
}
.bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34px;
  padding: 0 12px;
  border-radius: 8px;
  font-size: 14px;
  background: rgba(255, 255, 255, 0.14);
}
.bar-btn-exit { padding: 0 13px; }
/* 工具按钮集中在顶栏左侧 */
.bar-left { display: flex; align-items: center; }
.bar-left .bar-btn { margin-right: 8px; }
.bar-left .bar-btn:last-child { margin-right: 0; }
/* 右侧留空：避让系统胶囊（··· 与退出按钮），横屏下不与自定义按钮重叠 */
.bar-cap { flex: 0 0 auto; width: 88px; }
.bar-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  padding: 0 12px;
}
.bar-hover { opacity: 0.7; }
/* 竖屏顶栏避让状态栏：read 页为 custom 导航，页面自屏幕最顶端绘制，
   故在顶栏高度/内边距上补出状态栏（--sb，由组件注入）高度，避免被时间/电量条压住。
   仅竖屏生效（横屏不加 bar-portrait → 零改动）。 */
.bar-portrait {
  height: calc(46px + var(--sb));
  padding-top: var(--sb);
  box-sizing: border-box;
}

/* ------------------------------- 主体 ------------------------------- */
.body {
  flex: 1;
  display: flex;
  position: relative;
  min-height: 0;
}

/* 文章区（右侧，自动占满剩余宽度） */
.article {
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
  background: #fff;
}
.article::-webkit-scrollbar { display: none; }
.art-pad { padding: 14px 20px 30px; }
.para { margin-bottom: 0.95em; }
.wd { color: #1F2328; }
.wd-saved {
  color: #C0392B;
  border-bottom: 1px dashed #C0392B;
}
.tx, .para-plain { color: #1F2328; }
.para-zh {
  display: block;
  margin-top: 0.4em;
  font-size: 0.78em;
  line-height: 1.75;
  color: #8A939B;
}
.art-foot {
  margin-top: 1.4em;
  padding-top: 10px;
  border-top: 1px solid #F0F2F3;
  font-size: 0.66em;
  color: #B0B6BB;
}

/* 题卡区（左侧，宽度由 inline style 绑定 panelW 控制） */
.card-area {
  position: relative;
  height: 100%;
  overflow: hidden;
  background: #EEF1F2;
  transition: margin-left 0.25s ease, transform 0.25s ease;
}
/* 可拖拽分隔条（题卡面板右边界）
   注意：命中区放大到 14px，视觉上仍只是一条细线（::before），避免「抓不住」 */
.divider {
  flex: 0 0 auto;
  position: relative;
  width: 14px;
  height: 100%;
  background: #F5F7F7;
  cursor: col-resize;
  touch-action: none;
}
/* 可见的细线（贯穿整条分隔条） */
.divider::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  width: 3px;
  height: 100%;
  transform: translateX(-50%);
  background: #DCE1E3;
}
/* 收起按钮：放回分隔条正中（用户习惯的位置），本身就充当抓取把手。
   注意：UI 上只有 catchtap，不拦 touchstart —— 所以「按住拖动」照样能调宽，
   轻点才收起。两者互不抢占（WeChat 的 tap 在手指移动后不会触发）。 */
.collapse-btn {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  transform: translate(-50%, -50%);
  width: 34px;
  height: 34px;
  line-height: 32px;
  text-align: center;
  border-radius: 50%;
  background: #1F5C4A;
  color: #fff;
  font-size: 15px;
  box-shadow: 0 2px 8px rgba(20, 40, 30, 0.3);
}

/* 折叠后的可拖动小悬浮窗（单击展开） */
.q-float {
  position: absolute;
  z-index: 60;
  min-width: 64px;
  padding: 8px 12px;
  border-radius: 10px;
  background: #1F5C4A;
  color: #fff;
  text-align: center;
  box-shadow: 0 6px 18px rgba(20, 40, 30, 0.3);
  touch-action: none;
}
.q-float .qf-no { font-size: 14px; font-weight: 600; line-height: 1.3; }
.q-float .qf-sub { font-size: 10px; opacity: 0.75; line-height: 1.5; }
.q-float .qf-tip { font-size: 10px; opacity: 0.9; line-height: 1.5; }

/* 句尾 / 题干 / 选项的「译」按钮 */
.zh-btn {
  display: inline-block;
  margin-left: 5px;
  padding: 0 5px;
  font-size: 11px;
  line-height: 17px;
  color: #1F5C4A;
  background: #E7F0EC;
  border: 1px solid #CFE0D8;
  border-radius: 9px;
  vertical-align: baseline;
}
.zh-btn-sm { font-size: 10px; line-height: 15px; padding: 0 4px; }
.zh-btn-on { background: #1F5C4A; color: #fff; border-color: #1F5C4A; }

/* 展开后的单句译文：独占一行，避免中英混排串行 */
.sent-zh {
  display: block;
  margin: 3px 0 5px 2px;
  padding-left: 8px;
  border-left: 2px solid #E7F0EC;
  font-size: 0.8em;
  line-height: 1.7;
  color: #8A939B;
}

/* 页内字号调节浮层 */
.font-pop {
  position: absolute;
  top: 54px;
  right: 10px;
  z-index: 200;
  width: 250px;
  padding: 12px 14px 6px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 10px 28px rgba(20, 40, 30, 0.22);
}
.font-pop-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
  font-size: 14px;
  font-weight: 600;
  color: #1F2328;
}
.font-pop-close {
  width: 26px;
  height: 26px;
  line-height: 26px;
  text-align: center;
  border-radius: 6px;
  background: #EEF1F2;
  color: #6B7378;
  font-size: 13px;
}
.font-row {
  display: flex;
  align-items: center;
  margin: 6px 0;
}
.font-lab {
  flex: 0 0 auto;
  width: 64px;
  font-size: 13px;
  color: #4A5259;
}
.font-sl {
  flex: 1;
  margin: 0 6px;
}
.q-card {
  position: absolute;
  left: 0;
  top: 0;
  width: 86%;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(20, 40, 30, 0.14);
  will-change: transform;
}
.q-card-on { box-shadow: 0 8px 26px rgba(31, 92, 74, 0.28); }
.q-head {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 38px;
  padding: 0 10px;
  background: #1F5C4A;
  color: #fff;
  border-radius: 12px 12px 0 0;
}
.q-no { font-size: 13px; font-weight: 600; }
.q-type {
  margin-left: 8px;
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.16);
}
/* 标题栏上的「最小化」按钮（负 margin 把命中区扩到卡片右缘） */
.q-mini {
  margin-left: auto;
  margin-right: -8px;
  padding: 0 12px;
  font-size: 16px;
  line-height: 38px;
  opacity: 0.9;
}
/* 缩成小悬浮签：整卡收成胶囊，仅剩标题栏，可继续拖动，轻点恢复 */
.q-card-mini {
  width: auto;
  min-width: 132px;
  max-width: 86%;
  border-radius: 22px;
  box-shadow: 0 5px 16px rgba(20, 40, 30, 0.22);
  opacity: 0.92;
}
.q-card-mini .q-head {
  border-radius: 22px;
  padding: 0 14px;
  height: 36px;
  line-height: 36px;
  cursor: pointer;
}
.q-restore {
  margin-left: auto;
  font-size: 11px;
  opacity: 0.9;
}
.q-body {
  flex: 1;
  min-height: 0;
  max-height: 64vh;
  padding: 10px 12px 0; /* 底部留 0：滚动范围由 .q-body-tail 占位块补足（微信 scroll-view 的 padding-bottom 不计入滚动范围） */
}
.q-body::-webkit-scrollbar { display: none; }
/* 滚动内容尾部占位：保证滚到底时「提交本题」完整可见 */
.q-body-tail { height: 16px; }

/* 「题目可下滑」提示条：当前卡内容超屏且未滚动过时显示 */
.q-scroll-hint {
  position: absolute;
  right: 12px;
  bottom: 10px;
  z-index: 2;
  padding: 4px 10px;
  border-radius: 12px;
  background: rgba(31, 92, 74, 0.88);
  color: #fff;
  font-size: 11px;
  line-height: 1.4;
  pointer-events: none;
  box-shadow: 0 2px 8px rgba(20, 40, 30, 0.25);
}

.q-stem {
  font-size: 1em;
  line-height: 1.5;
  color: #1F2328;
  margin-bottom: 8px;
}
.q-stem-zh {
  display: block;
  font-size: 0.82em;
  line-height: 1.5;
  color: #8A939B;
  margin-bottom: 8px;
}

.q-opts { margin-top: 2px; }
.opt {
  display: flex;
  align-items: flex-start;
  padding: 7px 9px;
  margin-bottom: 6px;
  border: 1px solid #E6E8EA;
  border-radius: 8px;
  background: #FBFCFC;
}
.opt-l {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  line-height: 16px;
  margin-right: 8px;
  margin-top: 1px;
  text-align: center;
  border-radius: 4px;
  background: #E7F0EC;
  color: #1F5C4A;
  font-size: 11px;
  font-weight: 700;
}
.opt-body { flex: 1; min-width: 0; }
/* 选项正文用 inline，让末尾的「译」按钮跟在同一行；选项中译换行显示 */
.opt-t { display: inline; font-size: 0.92em; line-height: 1.45; color: #1F2328; }
.opt-zh { display: block; font-size: 0.82em; line-height: 1.45; color: #8A939B; margin-top: 2px; }
.opt-mark {
  flex: 0 0 auto;
  margin-left: 6px;
  margin-top: 1px;
  font-size: 10px;
  color: #E74C3C;
  white-space: nowrap;
}
.opt-pick { border-color: #1F5C4A; background: #EFF6F3; }
.opt-pick .opt-l { background: #1F5C4A; color: #fff; }
.opt-ok { border-color: #27AE60; background: #EAF7EF; }
.opt-ok .opt-l { background: #27AE60; color: #fff; }
.opt-bad { border-color: #E74C3C; background: #FDECEA; }
.opt-bad .opt-l { background: #E74C3C; color: #fff; }

.q-actions { margin-top: 8px; }
.q-btn {
  height: 32px;
  line-height: 32px;
  text-align: center;
  border-radius: 8px;
  font-size: 13px;
}
.q-btn-submit { background: #1F5C4A; color: #fff; }
.q-btn-done { background: #EFF1F2; color: #4A5259; }

/* 解析 */
.q-analysis {
  margin-top: 10px;
  padding-top: 8px;
  border-top: 1px dashed #E6E8EA;
}
.an-res {
  display: inline-block;
  font-size: 0.95em;
  font-weight: 600;
  padding: 4px 9px;
  border-radius: 6px;
  margin-bottom: 8px;
}
.an-ok { color: #1B7A45; background: #EAF7EF; }
.an-bad { color: #B0362A; background: #FDECEA; }
.an-missing { font-size: 0.9em; color: #8A939B; }
.an-block { margin-bottom: 8px; }
.an-lp { font-size: 0.84em; font-weight: 600; color: #1F5C4A; margin-bottom: 3px; }
.an-le { display: block; font-size: 0.9em; line-height: 1.5; color: #2A2F33; }
.an-lz { display: block; font-size: 0.82em; line-height: 1.5; color: #8A939B; margin-top: 2px; }
.an-row { display: flex; margin-bottom: 5px; }
.an-tag {
  flex: 0 0 auto;
  height: 16px;
  line-height: 16px;
  padding: 0 5px;
  margin-right: 6px;
  border-radius: 4px;
  background: #E7F0EC;
  color: #1F5C4A;
  font-size: 0.72em;
}
.an-tx { flex: 1; min-width: 0; font-size: 0.85em; line-height: 1.55; color: #3A4046; }
.an-note { padding: 6px 0; border-top: 1px solid #F0F2F3; }
.an-note-hd { display: flex; align-items: center; margin-bottom: 2px; }
.an-nl { font-size: 0.82em; font-weight: 700; color: #1F2328; margin-right: 6px; }
.an-flag { font-size: 0.75em; color: #B0362A; }
.an-flag-ok { color: #1B7A45; }
.an-nt { display: block; font-size: 0.8em; line-height: 1.5; color: #6B7378; }

.card-hint {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  text-align: center;
  color: #A5ACB1;
  font-size: 13px;
}

.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A939B;
  font-size: 15px;
}

/* ------------------------------- 底部条 ------------------------------- */
.foot {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 48px;
  padding: 0 12px;
  background: #fff;
  border-top: 1px solid #E6E8EA;
}
.foot-nav {
  height: 34px;
  line-height: 34px;
  padding: 0 14px;
  border-radius: 8px;
  background: #EFF1F2;
  color: #3A4046;
  font-size: 14px;
}
.foot-prog {
  min-width: 62px;
  text-align: center;
  font-size: 14px;
  color: #4A5259;
}
.foot-spacer { flex: 1; }
.foot-btn {
  height: 34px;
  line-height: 34px;
  padding: 0 16px;
  margin-left: 10px;
  border-radius: 8px;
  background: #EFF1F2;
  color: #3A4046;
  font-size: 14px;
}
.foot-btn-main { background: #1F5C4A; color: #fff; }
.foot-hover { opacity: 0.75; }

/* ------------------------------- 竖屏阅读 ------------------------------- */
/* 竖屏主体：上下分栏——上「文章」、中横向分隔条、下「题卡区」，两块共存。
   用 order 重排：DOM 里仍是 [题卡, 竖分隔条, 横分隔条, 恢复条, 文章]，
   竖屏下强制显示为 文章(1) → 分隔条/恢复条(2) → 题卡(3)。 */
.body-portrait { flex-direction: column; }
.body-portrait .article {
  order: 1;
  flex: 1 1 auto;
  width: 100%;
  height: auto;
  min-height: 0;
}
.body-portrait .divider-h { order: 2; }
.body-portrait .panel-restore-h { order: 2; }
/* 竖屏题卡区：固定高度（内联 --ph）、整块纵向滚动的卡片列表 */
.body-portrait .card-area {
  order: 3;
  width: 100% !important;
  height: var(--ph);
  flex: 0 0 auto;
  min-height: 0;
  overflow-y: auto;
  padding: 10px;
  box-sizing: border-box;
}
/* 竖屏题卡：覆盖内联绝对定位与 transform，改为常规流式卡片 */
.body-portrait .q-card {
  position: static !important;
  transform: none !important;
  width: 100% !important;
  max-height: none;
  margin-bottom: 12px;
  z-index: auto !important;
}
.body-portrait .q-card-mini { width: 100% !important; }
.body-portrait .q-body { max-height: none; }
/* 竖屏隐藏横屏专属元素（拖动把手钮、下滑提示、竖向分隔条、悬浮签） */
.body-portrait .q-mini,
.body-portrait .q-scroll-hint,
.body-portrait .divider,
.body-portrait .q-float {
  display: none !important;
}

/* 横向可拖拽分隔条（竖屏用）：命中区 14px 高，::before 画一条水平细线 */
.divider-h {
  flex: 0 0 auto;
  position: relative;
  width: 100%;
  height: 14px;
  background: #F5F7F7;
  touch-action: none;
}
.divider-h::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 3px;
  transform: translateY(-50%);
  background: #DCE1E3;
}
/* 横向分隔条正中的收起按钮：箭头旋转 90°（指向下方＝收起） */
.collapse-btn-h { transform: translate(-50%, -50%) rotate(90deg); }

/* 竖屏收起题卡区后，底部常驻的整宽恢复条 */
.panel-restore-h {
  flex: 0 0 auto;
  width: 100%;
  height: 40px;
  line-height: 40px;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  background: #1F5C4A;
}

/* 竖屏底部条：强制折成两行（上题/进度/下题 ＋ 提交全部/清空作答），文字不截断。
   关键：flex 换行按「假想主尺寸」判定，各控件 basis=0 时不会自动折行，
   故用 .foot-spacer 改成整宽零高占位块，强制在此处断行（3+2）。 */
.foot-portrait {
  height: auto;
  padding: 6px 8px;
  flex-wrap: wrap;
}
.foot-portrait .foot-spacer {
  flex: 0 0 100%;
  height: 0;
}
.foot-portrait .foot-nav {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 6px;
  font-size: 13px;
  text-align: center;
  white-space: nowrap;
}
.foot-portrait .foot-prog {
  flex: 0 0 48px;
  min-width: 48px;
  margin: 0 6px;
  font-size: 13px;
}
.foot-portrait .foot-btn {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 8px;
  margin-left: 0;
  font-size: 13px;
  text-align: center;
  white-space: nowrap;
}
.foot-portrait .foot-btn + .foot-btn { margin-left: 8px; }

/* 组件内自带 ellipsis：styleIsolation=isolated 时 app.wxss 的全局类不生效 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
