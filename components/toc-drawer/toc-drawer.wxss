/* components/toc-drawer/toc-drawer.wxss */
.toc-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 8001;
  background: rgba(12, 24, 18, 0.35);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease;
}
.toc-mask-on { opacity: 1; visibility: visible; }

.toc-panel {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 8002;
  width: 38vw;
  min-width: 220px;
  max-width: 380px;
  display: flex;
  flex-direction: column;
  background: #fff;
  box-shadow: 6px 0 24px rgba(20, 40, 30, 0.16);
  transform: translateX(-104%);
  transition: transform 0.24s ease;
}
.toc-panel-on { transform: translateX(0); }

.toc-head {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 46px;
  padding: 0 14px;
  background: #1F5C4A;
  color: #fff;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}
.toc-title { font-size: 15px; font-weight: 600; }
.toc-close {
  margin-left: auto;
  width: 30px;
  height: 30px;
  line-height: 30px;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  font-size: 14px;
}

.toc-body {
  flex: 1;
  min-height: 0;
  padding: 6px 0 20px;
}
.toc-body::-webkit-scrollbar { display: none; }

.toc-sec {
  margin: 12px 14px 6px;
  font-size: 11px;
  letter-spacing: 1px;
  color: #A5ACB1;
}
.toc-item {
  display: flex;
  align-items: center;
  padding: 9px 14px;
}
.toc-item-on { background: #EFF6F3; }
.toc-tag {
  flex: 0 0 auto;
  width: 54px;
  font-size: 12px;
  font-weight: 600;
  color: #1F5C4A;
}
.toc-prev { flex: 1; min-width: 0; font-size: 12px; color: #4A5259; }
.toc-done {
  flex: 0 0 auto;
  margin-left: 6px;
  padding: 1px 5px;
  border-radius: 4px;
  background: #EAF7EF;
  color: #1B7A45;
  font-size: 10px;
}
.toc-empty {
  padding: 6px 14px;
  font-size: 12px;
  color: #B0B6BB;
}
.toc-foot-space { height: 24px; }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
