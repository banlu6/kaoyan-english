/* app.wxss —— 全局样式与设计变量 */

/* 设计变量：主色墨绿、生词朱红、对错绿红 */
page {
  --brand: #1F5C4A;
  --brand-weak: #E7F0EC;
  --brand-light: #2E7561;
  --accent: #C0392B;
  --ok: #27AE60;
  --bad: #E74C3C;
  --ink: #1F2328;
  --ink-2: #4A5259;
  --ink-3: #8A939B;
  --line: #E6E8EA;
  --bg: #F4F5F6;
  --card: #FFFFFF;
  --radius: 16rpx;
  --shadow: 0 6rpx 20rpx rgba(20, 40, 30, 0.06);

  background-color: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* 通用容器 */
.page-wrap {
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

/* 主按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-primary--active {
  opacity: 0.86;
}

.btn-ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--brand);
}

.btn-plain {
  background: #EEF1F2;
  color: var(--ink-2);
}

.btn-danger {
  background: #fff;
  color: var(--bad);
  border: 2rpx solid rgba(231, 76, 60, 0.5);
}

/* 文本工具 */
.t-title { font-size: 36rpx; font-weight: 600; color: var(--ink); }
.t-sub { font-size: 26rpx; color: var(--ink-3); }
.t-muted { color: var(--ink-3); }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 分割线 */
.hr {
  height: 2rpx;
  background: var(--line);
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  text-align: center;
  color: var(--ink-3);
}
.empty-icon { font-size: 88rpx; margin-bottom: 24rpx; opacity: 0.5; }
.empty-text { font-size: 28rpx; line-height: 1.8; }

/* 轻点反馈 */
.hover-dim { opacity: 0.7; }
