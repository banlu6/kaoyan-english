/* pages/vocab/vocab.wxss */
.vocab { padding-bottom: 60rpx; }

.v-head {
  display: flex;
  align-items: baseline;
  padding: 32rpx 32rpx 20rpx;
}
.v-title { font-size: 40rpx; font-weight: 700; color: #1F2328; }
.v-count { margin-left: auto; font-size: 24rpx; color: #8A939B; }

.v-search-wrap { padding: 0 32rpx; }
.v-search {
  height: 80rpx;
  padding: 0 26rpx;
  background: #fff;
  border-radius: 14rpx;
  font-size: 27rpx;
  color: #1F2328;
  box-shadow: 0 4rpx 16rpx rgba(20, 40, 30, 0.05);
}
.v-ph-holder { color: #B0B6BB; }

.v-filters {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx 8rpx;
}
.v-pick {
  max-width: 220rpx;
  margin-right: 16rpx;
}
.v-pick-in {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #4A5259;
  box-shadow: 0 3rpx 12rpx rgba(20, 40, 30, 0.05);
}
.v-export {
  margin-left: auto;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 26rpx;
  background: #1F5C4A;
  color: #fff;
  border-radius: 12rpx;
  font-size: 25rpx;
}

.v-list { padding: 12rpx 32rpx 0; }
.v-item {
  display: flex;
  padding: 26rpx 26rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 40, 30, 0.05);
}
.v-main { flex: 1; min-width: 0; }
.v-word-line { display: flex; align-items: baseline; }
.v-word { font-size: 32rpx; font-weight: 600; color: #1F5C4A; }
.v-ph { margin-left: 12rpx; font-size: 23rpx; color: #8A939B; }
.v-pos {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #1F5C4A;
  background: #E7F0EC;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.v-cn { margin-top: 8rpx; font-size: 27rpx; line-height: 1.5; color: #2A2F33; }
.v-meta { display: flex; align-items: center; margin-top: 10rpx; }
.v-src { flex: 1; min-width: 0; font-size: 22rpx; color: #A5ACB1; margin-right: 12rpx; }
.v-time { flex: 0 0 auto; font-size: 22rpx; color: #C4CACD; }

.v-side {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  margin-left: 18rpx;
}
.v-level {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
}
.v-level-0 { background: #FDECEA; color: #B0362A; }
.v-level-1 { background: #FFF6E6; color: #B7791F; }
.v-level-2 { background: #EAF7EF; color: #1B7A45; }
.v-btns { display: flex; align-items: center; margin-top: 14rpx; }
.v-icon {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F5;
  font-size: 26rpx;
  margin-left: 12rpx;
}
.v-icon-del { color: #8A939B; }

.empty-btn {
  margin-top: 32rpx;
  padding: 20rpx 44rpx;
  background: #1F5C4A;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
