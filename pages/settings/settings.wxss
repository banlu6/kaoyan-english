/* pages/settings/settings.wxss */
.set { padding: 8rpx 28rpx 60rpx; }

.sec {
  margin: 30rpx 8rpx 14rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: #8A939B;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 40, 30, 0.05);
  overflow: hidden;
}
.hr { height: 2rpx; background: #F2F4F5; margin-left: 28rpx; }

.row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 28rpx;
}
.row-l { flex: 0 0 auto; font-size: 28rpx; color: #1F2328; }
.row-s { flex: 1; margin-left: 24rpx; }
.row-sw { justify-content: space-between; }
.row-btn {
  padding: 14rpx 28rpx;
  background: #E7F0EC;
  color: #1F5C4A;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.hint {
  padding: 0 28rpx 22rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #A5ACB1;
}
.hint-warn { color: #B7791F; }

.d-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 28rpx;
}
.d-l { flex: 0 0 auto; font-size: 28rpx; color: #1F2328; }
.d-meta { margin-left: auto; font-size: 23rpx; color: #A5ACB1; }

.foot-note {
  margin: 40rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
  color: #B0B6BB;
  text-align: center;
}

/* 联系与反馈入口行 */
.row-link { justify-content: space-between; cursor: pointer; }
.row-chev { font-size: 34rpx; color: #C2C8CC; }

/* 联系弹窗（与首页同款样式，settings 页自带一份） */
.contact-mask {
  position: fixed;
  inset: 0;
  z-index: 9000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(18, 28, 24, 0.42);
}
.contact-pop {
  width: 560rpx;
  max-width: 84%;
  padding: 30rpx 32rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 18rpx 48rpx rgba(12, 24, 18, 0.28);
  color: #1F2328;
}
.contact-hd {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2328;
}
.contact-close {
  margin-left: auto;
  align-self: flex-start;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F5;
  color: #6B7378;
  font-size: 26rpx;
}
.contact-line {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #F7F9F8;
  cursor: pointer;
}
.contact-lab {
  flex: 0 0 auto;
  width: 120rpx;
  font-size: 26rpx;
  color: #8A939B;
}
.contact-val {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1F2328;
}
.contact-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #B0B6BB;
  text-align: center;
}
.gh-block {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gh-qrcode {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E6E8EA;
}
.gh-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B7378;
}
